{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Notifications": "Host=localhost;Port=5432;Database=notifications;Username=notifications;Password=notifications"
  },
  "Notifications": {
    "Providers": {
      "Twilio": { "Enabled": true, "Priority": 1, "Channels": [ "Sms" ] },
      "Vonage": { "Enabled": true, "Priority": 2, "Channels": [ "Sms" ] },
      "Smtp": { "Enabled": true, "Priority": 1, "Channels": [ "Email" ] },
      "AmazonSes": { "Enabled": true, "Priority": 2, "Channels": [ "Email" ] }
    },
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "Auto",
      "FromAddress": "notifications@example.com",
      "FromName": "Notification Service"
    },
    "Dispatch": {
      "DeliveryAttemptTimeout": "00:00:10",
      "Retry": {
        "MaxDispatches": 8,
        "InitialDelay": "00:01:00",
        "MaxDelay": "01:00:00",
        "JitterFactor": 0.2
      }
    },
    "Worker": {
      "PollingInterval": "00:00:05",
      "BatchSize": 20,
      "LeaseDuration": "00:02:00"
    }
  }
}
