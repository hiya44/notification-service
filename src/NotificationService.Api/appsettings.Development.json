{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Notifications": {
    "Providers": {
      "Twilio": { "Simulation": { "FailureRate": 0.3, "Latency": "00:00:00.300" } },
      "Vonage": { "Simulation": { "Latency": "00:00:00.200" } }
    },
    "Dispatch": {
      "Retry": {
        "InitialDelay": "00:00:10",
        "MaxDelay": "00:02:00"
      }
    },
    "Worker": {
      "PollingInterval": "00:00:02"
    }
  }
}
